{
  "version": 2,
  "builds": [
    {
      "src": "dist/apps/feportafolio/server/main.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/apps/feportafolio/browser/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/apps/feportafolio/server/main.js"
    }
  ],
  "buildCommand": "npx nx build feportafolio --configuration=production && npx nx run feportafolio:server:production"
}
