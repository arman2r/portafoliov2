{
  "version": 2,
  "builds": [
    {
      "src": "dist/apps/about/server/main.js",
      "use": "@vercel/node"
    },
    {
      "src": "dist/apps/about/browser/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "dist/apps/about/server/main.js"
    }
  ],
  "buildCommand": "npx nx build about && npx nx build about --configuration=production",
  "outputDirectory": "dist/apps/about"
}
